 "html": "<div style=\"font-family: Arial, sans-serif; color: #333; padding: 30px 40px; max-width: 180mm; margin: 0 auto;\">\n  <div style=\"text-align: center; margin-bottom: 28px;\">\n    <h2 style=\"margin: 0 0 4px 0;\">Potrdilo o dodelitvi RFID identifikacijske kartice</h2>\n    <div style=\"color: #666;\">{{ doc.school_name or \"\" }}</div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 12pt;\">\n    <tr>\n      <td style=\"padding: 6px 0;\"><b>Datum:</b></td>\n      <td style=\"padding: 6px 0;\">{{ frappe.utils.formatdate(doc.transaction_date, \"dd. MM. yyyy\") }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 0;\"><b>Učenec:</b></td>\n      <td style=\"padding: 6px 0;\">{{ doc.ucenec_name or doc.ucenec }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 0;\"><b>Učenec ID:</b></td>\n      <td style=\"padding: 6px 0;\">{{ doc.ucenec_id or \"-\" }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 0;\"><b>Oddelek:</b></td>\n      <td style=\"padding: 6px 0;\">{{ doc.oddelek or \"-\" }}</td>\n    </tr>\n  </table>\n\n  <div style=\"background: #f0f7ff; border: 2px solid #4a90d9; border-radius: 8px; padding: 14px 24px; text-align: center; margin: 22px 0;\">\n    <div style=\"margin-bottom: 4px;\">Vaš novi RFID</div>\n    <div style=\"font-family: monospace; font-size: 16pt; font-weight: bold; color: #2c5f9e;\">{{ doc.new_rfid }}</div>\n  </div>\n\n  <p style=\"margin-top: 26px; font-size: 11.5pt;\">\n    S podpisom potrdim prevzem nove RFID identifikacijske kartice. Zavezujem se, da jo bom skrbno hranil/a in uporabljal/a v skladu s pravili šole.\n  </p>\n\n  <div style=\"margin-top: 60px; display: flex; justify-content: space-between;\">\n    <div style=\"text-align: center; width: 200px; border-top: 1px solid #333; padding-top: 6px;\">Podpis učenca / starša</div>\n    <div style=\"text-align: center; width: 200px; border-top: 1px solid #333; padding-top: 6px;\">Podpis šole</div>\n  </div>\n</div>",
